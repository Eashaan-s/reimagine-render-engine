{
  "name": "reimagine-render-engine",
  "version": "0.1.0",
  "description": "Reimagine Render Engine — architectural wireframe to photorealistic render",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "convert-workflow": "node scripts/convert-workflow.js",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "comfyui",
    "architecture",
    "ai-render"
  ],
  "author": "Capstone project",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.reimagine.renderengine",
    "productName": "Reimagine Render Engine",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/.env",
      "!**/.env.*",
      "!dist/**/*",
      "!progress/**/*",
      "!docs/**/*"
    ],
    "extraResources": [
      {
        "from": ".env.boss-example",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reimagine Render Engine"
    }
  }
}
