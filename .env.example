# Render backend: "local" (ComfyUI on this machine, fully offline) or "runpod".
# Leave blank to auto-detect: RunPod if its keys are set below, otherwise local.
RENDER_BACKEND=

# --- Local ComfyUI backend (offline) ---
# URL of the ComfyUI server running on this machine.
COMFYUI_URL=http://127.0.0.1:8188

# Match these to the exact model filenames present in the local ComfyUI.
# Leave blank to use the filenames baked into workflow-api.json (RunPod setup).
COMFY_UNET_NAME=
COMFY_VAE_NAME=

# Auto-start ComfyUI (Option A). Point COMFYUI_PATH at the ComfyUI portable root
# (folder containing python_embeded\ and ComfyUI\). Blank = don't auto-start;
# only connect to a ComfyUI that's already running.
COMFYUI_PATH=
# COMFYUI_LAUNCH_CMD=
ENGINE_READY_TIMEOUT_MS=180000

# --- RunPod Serverless backend (cloud) ---
# Get your API key from https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here
RUNPOD_BASE_URL=https://api.runpod.ai/v2

# Polling (applies to both backends)
POLL_INTERVAL_MS=3000
POLL_TIMEOUT_MS=600000
