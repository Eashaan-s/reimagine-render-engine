# ============================================================
# Reimagine Render Engine - config for the OFFLINE / local PC
# When packaging the app to send, rename this file to ".env"
# ============================================================

# Use the local ComfyUI on this machine (fully offline, no cloud).
RENDER_BACKEND=local

# ComfyUI server on this machine. Change only if ComfyUI runs on another port.
COMFYUI_URL=http://127.0.0.1:8188

# Path to the ComfyUI install on this PC so the app can start it automatically
# in the background (no console window). Point this at the PORTABLE ROOT folder
# that contains "python_embeded" and "ComfyUI". Example:
#   COMFYUI_PATH=C:\AI\ComfyUI_windows_portable
# If left blank, the app will only connect to a ComfyUI you start yourself.
COMFYUI_PATH=

# Optional: full launch command override (advanced). If set, used instead of COMFYUI_PATH.
# COMFYUI_LAUNCH_CMD=

# How long to wait (ms) for the engine to become ready before giving up.
ENGINE_READY_TIMEOUT_MS=180000

# Model filenames MUST match the files in this machine's ComfyUI/models folders.
# These are taken from the REIMAGINE workflow. If ComfyUI reports a model is
# "not in list", open ComfyUI, check the exact filename, and paste it here.
COMFY_UNET_NAME=qwen_image_edit_2511_bf16.safetensors
COMFY_VAE_NAME=Qwen_Image-VAE.safetensors

# Polling (local renders can take a while; 30 min ceiling)
POLL_INTERVAL_MS=2000
POLL_TIMEOUT_MS=1800000
